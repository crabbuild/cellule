    "fumadocs-ui": "16.15.17",
    "lucide-react": "^0.544.0",
    "mermaid": "^11.12.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
